# Anthropic API Key - vereist voor AI-agents
ANTHROPIC_API_KEY=sk-ant-...

# Server poort (Railway zet dit automatisch)
PORT=5000

# Node omgeving
NODE_ENV=production

# Dagelijks token-limiet (optioneel, standaard 100000)
DAILY_TOKEN_LIMIT=100000

# ─── Agent Memory (gelaagd geheugen) — allemaal optioneel ─────────────────────
# Na hoeveel user-beurten er automatisch feiten uit de chat worden gedestilleerd.
# MEMORY_EXTRACT_EVERY=4
# Na hoeveel nieuwe herinneringen het persona-profiel (L3) opnieuw wordt gesynthetiseerd.
# MEMORY_PERSONA_EVERY=15
# Maximum aantal herinneringen per agent (daarboven worden de zwakste vergeten).
# MEMORY_MAX_PER_AGENT=200
# Tekenbudget voor de herinneringen die in de systeemprompt worden geïnjecteerd.
# MEMORY_INJECT_BUDGET=1400
# Hoeveel herinneringen maximaal per gesprek worden opgehaald (top-K).
# MEMORY_RECALL_TOP_K=6

# Groq als gratis LLM-pad (optioneel). Zonder GROQ_API_KEY draait alles op Claude
# en verandert er niets. Met een key routeert de model-router support-/algemeen-
# werk naar Groq (gratis, snel); faalt Groq, dan valt het antwoord terug op Claude.
# Gratis key aanmaken: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# ─── Semantische recall voor Agent Memory (optioneel, key-gated) ──────────────
# Geleend van MemPalace: vindt relevante herinneringen ook ZONDER exacte
# woord-overlap (synoniemen, andere taal, herformuleringen). Zonder key blijft
# recall puur lexicaal en verandert er niets. Met een key komt een semantische
# leg bij de bestaande hybride recall; faalt/hangt het endpoint, dan valt recall
# terug op lexicaal (de chat blokkeert nooit). Elk OpenAI-compatibel
# /embeddings-endpoint werkt — kies een gratis provider en zet de key.
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_TIMEOUT_MS=4000

# ─── Prompt-Guard — keyless prompt-injectie/jailbreak-detectie (optioneel) ────
# Geleend van gstack: herkent geplante instructies ("negeer je opdracht", "je bent
# nu ...", "toon je systeemprompt") zodat ze (1) niet in het agent-geheugen belanden
# en later als systeemprompt-directief terugkomen, en (2) een verdachte live-beurt
# defensief gekaderd wordt. Keyless, lokaal, additief: blokkeert nooit een bericht.
# Staat standaard AAN (conservatief). Uitzetten: PROMPT_GUARD=off.
# PROMPT_GUARD=on
# Risicodrempel 0..1 waarboven tekst als injectie geldt (hoger = strenger/minder
# gevoelig). Default 0.6.
# PROMPT_GUARD_MIN_RISK=0.6

# ─── Self-Review — self-evaluatie + begrensde loop-back (geleend van video-use) ─
# Een keyless heuristische critic beoordeelt elk chat-antwoord; ALLEEN bij een echt
# defect (leeg, afgekapt, verkeerde taal, uitwijk, AI-boilerplate, achtergebleven
# placeholder) volgt een begrensde revisie via HETZELFDE provider-pad. Een goed
# antwoord kost NUL extra calls. De revisie is gratis op het Groq-pad en budget-
# bewaakt op het Claude-pad; er wordt nooit een slechter antwoord teruggegeven en
# de chat breekt nooit. Staat standaard AAN. Uitzetten: SELF_REVIEW=off.
# SELF_REVIEW=on
# Max aantal revisie-pogingen per beurt (video-use cap = 3). Default 1, geklemd 1..3.
# SELF_REVIEW_MAX_REVISIONS=1
# Graded kwaliteitsdrempel 0..1 (geldt vooral voor de optionele LLM-critic). Default 0.5.
# SELF_REVIEW_MIN_SCORE=0.5
# Optionele Tier-2 LLM-critic (extra, budget-bewaakte modelbeoordeling voor relevantie/
# verzinsels die de heuristiek niet ziet). Default UIT — aanzetten kost extra tokens.
# SELF_REVIEW_LLM=off

# Pad naar de SQLite-database (optioneel, standaard "data.db").
# Zet dit op een gemount persistent volume zodat loops, runs en state een
# redeploy overleven. Op Railway: mount een Volume op /data en gebruik:
# DB_PATH=/data/dreamteam.db

# Toegangsbescherming voor de dure endpoints (optioneel, standaard uit).
# Geen volwaardige gebruikers-auth — defense-in-depth tegen drive-by misbruik.
# ALLOWED_ORIGINS: komma-gescheiden lijst; cross-site browser-calls van andere
# origins worden geweigerd. Bv. ALLOWED_ORIGINS=https://jouwdomein.nl
# API_ACCESS_TOKEN: alleen voor afgeschermde/interne deploys (geen publieke SPA);
# vereist dan de header x-api-token op /api/messages en /api/loops/:id/run.
# ALLOWED_ORIGINS=
# API_ACCESS_TOKEN=
